{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(restaurante_id) && !isNull(nombre_restaurante) && (trim(upper(activo)) == 'SÍ' || trim(upper(activo)) == 'SI' || trim(upper(activo)) == 'NO'),",
				"     disjoint: false) ~> split1@(validos, noValidos)",
				"split1@validos aggregate(groupBy(restaurante_id),",
				"     nombre_restaurante = first(nombre_restaurante),",
				"          tipo_cocina = first(tipo_cocina),",
				"          calificacion_promedio = first(calificacion_promedio),",
				"          activo = first(activo)) ~> aggregate1",
				"aggregate1 derive(nombre_restaurante = trim(nombre_restaurante),",
				"          tipo_cocina = initCap(trim(tipo_cocina)),",
				"          calificacion_promedio = iif(toDecimal(calificacion_promedio) > 5.0, toDecimal(5.0, 3, 2), toDecimal(calificacion_promedio, 3, 2)),",
				"          activo = iif(trim(upper(activo)) == 'SÍ' || trim(upper(activo)) == 'SI', true(), false())) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,2),",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}