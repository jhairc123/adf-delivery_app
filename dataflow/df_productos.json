{
	"name": "df_productos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productosMenu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productosMenu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "duplicados"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(producto_id) && !isNull(nombre_producto) && !isNull(categoria) && !isNull(precio_lista) && !isNull(disponible),",
				"     disjoint: false) ~> split1@(validos, noValidos)",
				"split1@validos aggregate(groupBy(producto_id),",
				"     nombre_producto = first(nombre_producto),",
				"          categoria = first(categoria),",
				"          precio_lista = first(precio_lista),",
				"          costo_estimado = first(costo_estimado),",
				"          disponible = first(disponible)) ~> duplicados",
				"duplicados derive(categoria = initCap(trim(categoria)),",
				"          precio_lista = toDecimal(replace(replace(precio_lista, 'Bs ', ''), 'Bs', ''), 12, 2),",
				"          costo_estimado = toDecimal(costo_estimado, 12, 2),",
				"          disponible = iif(trim(upper(disponible)) == 'SÍ' || trim(upper(disponible)) == 'SI', true(), false()),",
				"          nombre_producto = trim(nombre_producto)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista,",
				"          costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}