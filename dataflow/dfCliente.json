{
	"name": "dfCliente",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "cliente"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "clientes_sql",
						"type": "DatasetReference"
					},
					"name": "salidaCliente"
				}
			],
			"transformations": [
				{
					"name": "limpiarDatos"
				},
				{
					"name": "split1"
				},
				{
					"name": "duplicados"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cliente",
				"duplicados derive(nombre = initCap(trim(nombre)),",
				"          email = lower(trim(iif(isNull(email) || endsWith(email, '@'), 'sin_correo@delivery.bo', email))),",
				"          ciudad = iif(trim(upper(ciudad)) == 'SCZ', 'Santa Cruz de la Sierra', initCap(trim(ciudad))),",
				"          telefono = toString(telefono),",
				"          fecha_registro = toDate(fecha_registro, 'yyyy-MM-dd'),",
				"          segmento = initCap(trim(segmento))) ~> limpiarDatos",
				"cliente split(!isNull(cliente_id) && !isNull(nombre) && !isNull(email) && !isNull(telefono) && !isNull(ciudad) && !isNull(fecha_registro) && !isNull(segmento),",
				"     disjoint: false) ~> split1@(validos, noVAlidos)",
				"split1@validos aggregate(groupBy(cliente_id),",
				"     nombre = first(nombre),",
				"          email = first(email),",
				"          telefono = first(telefono),",
				"          ciudad = first(ciudad),",
				"          fecha_registro = first(fecha_registro),",
				"          segmento = first(segmento)) ~> duplicados",
				"limpiarDatos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as date,",
				"          segmento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          cliente_id,",
				"          nombre,",
				"          email,",
				"          telefono,",
				"          ciudad,",
				"          fecha_registro,",
				"          segmento",
				"     )) ~> salidaCliente"
			]
		}
	}
}